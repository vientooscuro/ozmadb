{
  "kestrel": {
    "endpoints": {
      "http": {
        "url": "http://0.0.0.0:5000"
      }
    }
  },
  "ozmaDB": {
    "authAuthority": "https://keycloak-host/auth/realms/default",
    "allowAutoMark": true,
    // "preload": "path/to/preload.json",
    // "redis": "redis-host:6379,password=password",
    "instancesSource": "static",
    "instance": {
      "host": "localhost",
      "username": "ozmadb",
      "password": "ozmadb",
      // "maxUsers": 40,
      // "readRateLimitsPerUser": [
      //   {"period": 1, "limit": 50}
      // ],
      // "writeRateLimitsPerUser": [
      //   {"period": 1, "limit": 50}
      // ],
      "disableSecurity": false,
      "isTemplate": false
    },
    // Alternatively, if you want to use a database for instances.
    // "instancesSource": "database",
    // "connectionStrings": {
    //   "instances": "Host=localhost; Database=instances",
    //   Needed if you want to use a read-only replica for most requests.
    //   "instancesReadOnly": "Host=localhost; Database=instances",
    // },
    "jobs": {
      "remoteIdleTimeout": "00:00:10",
      "hybridLocalTimeout": "00:00:25"
    },
    "javaScript": {
      "http": {
        "enabled": false,
        "allowedHosts": [
          "api.example.com",
          "*.internal.example.com"
        ],
        "defaultTimeoutMs": 5000,
        "maxTimeoutMs": 15000,
        "maxRetries": 2,
        "retryBaseDelayMs": 200,
        "userAgent": "ozmadb/0.0"
      },
      "outbox": {
        "enabled": true,
        "defaultTimeoutMs": 5000,
        "maxTimeoutMs": 15000,
        "maxRetries": 5,
        "retryBaseDelayMs": 500,
        "maxBodyBytes": 262144
      }
    },
    "outboxWorker": {
      "pollDelayMs": 1000,
      "maxBatchPerConnection": 64
    },
    // Opt-ins for the riskier /introspection endpoints (all of /introspection is root-only).
    "introspection": {
      // POST /introspection/sql: arbitrary SELECTs in a read-only transaction that is never committed. Root can
      // read anything the database role can, and read-only mode still allows side-effecting functions such as
      // pg_terminate_backend/pg_cancel_backend on other sessions of the same role. Refused when the database has
      // dblink/postgres_fdw or the role is privileged.
      "allowRawSql": false,
      // POST /introspection/dry_run with "mode": "full": runs the migration DDL and rolls it back, holding the
      // migration lock and locks on altered tables for up to ~30 s (statement_timeout). "plan" mode is always on.
      "allowFullDryRun": false
    }
  }
}
